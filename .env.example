# The Odds API (https://the-odds-api.com) — $30/mo tier, 20k credits/month
ODDS_API_KEY=
# Postgres connection string (Neon/Supabase in prod; local for dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nfl_edge
# Optional: alert when monthly credit usage crosses this fraction
ODDS_CREDIT_ALERT_FRACTION=0.70
ODDS_MONTHLY_CREDITS=20000

# --- live edge bot (/live, docs/LIVE.md) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LIVE_CREDIT_BUDGET=5000          # the bot's own monthly credit allowance (raise to 90000 on the 100k plan)
LIVE_PAPER_ONLY=true             # four-week paper period: cards stay unpublished
LIVE_DRY_RUN=false               # true = price + log, send nothing
LIVE_INGAME_ENABLED=false        # in-game odds polling (credits); the in-game paper projections run regardless
